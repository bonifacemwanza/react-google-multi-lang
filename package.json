{
  "name": "react-google-multi-lang",
  "version": "1.0.7",
  "description": "A library to support multi-language translation in React apps using Google Translation API.",
  "main": "dist/index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "NODE_ENV=production babel src --out-dir dist --out-file-extension .js --extensions \".js,.jsx\" --ignore \"src/test/**\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettify": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run prettify && npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bonifacemwanza/react-google-multi-lang.git"
  },
  "bugs": {
    "url": "https://github.com/bonifacemwanza/react-google-multi-lang/issues"
  },
  "homepage": "https://github.com/bonifacemwanza/react-google-multi-lang#readme",
  "keywords": [
    "react",
    "translation",
    "google-translate",
    "multi-language",
    "javascript"
  ],
  "author": "Boniface Mwanza",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.16.0",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
